# État de release Production attendu — source de vérité versionnée (R-V54-2).
#
# Ce fichier déclare ce que la Production est CENSÉE exécuter. Il est contrôlé par :
#   - la CI            : infra/release/check-release-state.sh --ci   (étape bloquante)
#   - le smoke         : infra/smoke/smoke-stack.sh lit FLYWAY_EXPECTED
#   - les tests        : SchemaMigrationTest lit FLYWAY_EXPECTED
#   - le contrôle live : infra/release/check-release-state.sh --host (déclaré vs réel)
#
# RÈGLE : toute bascule de tag en Production DOIT s'accompagner de la mise à jour de ce
# fichier, dans le même commit que le rapport de déploiement technique. Un oubli fait
# échouer le smoke et le contrôle de dérive — il ne peut plus passer inaperçu.
#
# Format volontairement plat (KEY=value, sans espaces) : sourçable en shell et lisible
# par un test Java sans dépendance de parsing.

# Version SemVer de la release en Production.
RELEASE_VERSION=1.14.0

# Tag d'image GHCR immuable déployé en Production.
PRODUCTION_TAG=sha-27dce09d

# Nombre de migrations Flyway appliquées avec succès attendu.
# Doit toujours égaler le nombre de fichiers V*.sql dans
# backend/src/main/resources/db/migration/ — vérifié par --ci.
FLYWAY_EXPECTED=28

# Horodatage UTC du PRODUCTION_DEPLOYED de cette release.
PRODUCTION_DEPLOYED_AT=2026-07-27T16:46:00Z
