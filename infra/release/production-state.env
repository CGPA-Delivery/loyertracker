# État de release Production attendu — source de vérité versionnée (R-V54-2).
#
# Ce fichier déclare ce que la Production est CENSÉE exécuter. Il est contrôlé par :
#   - la CI            : infra/release/check-release-state.sh --ci   (lit FLYWAY_EXPECTED_REPO)
#   - le smoke         : infra/smoke/smoke-stack.sh                  (lit FLYWAY_EXPECTED_REPO)
#   - les tests        : SchemaMigrationTest                         (lit FLYWAY_EXPECTED_REPO)
#   - le contrôle live : infra/release/check-release-state.sh --host (lit FLYWAY_EXPECTED_PROD)
#
# RÈGLE : toute bascule de tag en Production DOIT s'accompagner de la mise à jour de ce
# fichier, dans le même commit que le rapport de déploiement technique. Un oubli fait
# échouer le smoke et le contrôle de dérive — il ne peut plus passer inaperçu.
#
# Format volontairement plat (KEY=value, sans espaces) : sourçable en shell et lisible
# par un test Java sans dépendance de parsing.

# Version SemVer de la release en Production.
RELEASE_VERSION=1.14.0

# Tag d'image GHCR immuable déployé en Production.
# Conservé comme référence historique lisible ; les digests ci-dessous font autorité.
PRODUCTION_TAG=sha-27dce09d

# Références digest exactes résolues en lecture seule depuis GHCR pour le tag historique
# sha-27dce09d. Toute prochaine promotion remplace les deux valeurs avec celles du manifeste.
PRODUCTION_API_IMAGE_REF=ghcr.io/jptshilombo/loyertracker-api@sha256:089028b45a93afd4f12d5aa22cfc63a38f5687bb1d0f7204bc1965154ce8d7ff
PRODUCTION_WEB_IMAGE_REF=ghcr.io/jptshilombo/loyertracker-web@sha256:7dbc551ee722e1da7697d71749b94a731fce0b028b7b7288c88d8346488e8bc8

# Nombre de fichiers de migration V*.sql présents dans le dépôt
# (backend/src/main/resources/db/migration/). Bouge à CHAQUE migration ajoutée, indépendamment
# de ce qui est réellement déployé en Production. Contrôlé par --ci, SchemaMigrationTest et le
# smoke (candidat sous test).
FLYWAY_EXPECTED_REPO=29

# Nombre de migrations Flyway réellement appliquées avec succès en Production, pour le
# PRODUCTION_TAG déclaré ci-dessus. Ne bouge QU'À LA BASCULE en Production, dans le même commit
# que le rapport de déploiement technique — jamais en avance. Contrôlé par --host (déclaré vs
# réel sur l'hôte de production).
#
# Scindé de l'ex-variable unique FLYWAY_EXPECTED (réserve RSV-STG-N2-01, Gate Staging Sprint N+2
# EP-16, 2026-07-28) : une seule variable servait ces deux usages, qui divergent pendant tout
# sprint ajoutant une migration avant sa bascule en Production.
FLYWAY_EXPECTED_PROD=28

# Horodatage UTC du PRODUCTION_DEPLOYED de cette release.
PRODUCTION_DEPLOYED_AT=2026-07-27T16:46:00Z
